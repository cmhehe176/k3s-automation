---
apiVersion: v1
kind: Namespace
metadata:
  name: {{ redpanda_namespace }}
  labels:
    app.kubernetes.io/name: redpanda
---
apiVersion: v1
kind: ConfigMap
metadata:
  name: redpanda-info
  namespace: {{ redpanda_namespace }}
  labels:
    app: redpanda
data:
  KAFKA_BOOTSTRAP_SERVER: "{{ ansible_host }}:{{ redpanda_kafka_nodeport }}"
  INTERNAL_BOOTSTRAP_SERVER: "redpanda-0.redpanda-headless.{{ redpanda_namespace }}.svc.cluster.local:29092"
  SCHEMA_REGISTRY_URL: "http://{{ ansible_host }}:{{ redpanda_schema_nodeport }}"
  INTERNAL_SCHEMA_REGISTRY: "http://redpanda-0.redpanda-headless.{{ redpanda_namespace }}.svc.cluster.local:8081"
  CONSOLE_URL: "http://{{ ansible_host }}:{{ redpanda_console_nodeport }}"
---
apiVersion: v1
kind: Service
metadata:
  name: redpanda-headless
  namespace: {{ redpanda_namespace }}
  labels:
    app: redpanda
spec:
  clusterIP: None
  selector:
    app: redpanda
  ports:
  - name: kafka-internal
    port: 29092
    targetPort: 29092
  - name: kafka-external
    port: 9092
    targetPort: 9092
  - name: schema-registry
    port: 8081
    targetPort: 8081
  - name: admin
    port: 9644
    targetPort: 9644
  - name: rpc
    port: 33145
    targetPort: 33145
---
apiVersion: v1
kind: Service
metadata:
  name: redpanda-external
  namespace: {{ redpanda_namespace }}
  labels:
    app: redpanda
spec:
  type: NodePort
  selector:
    app: redpanda
  ports:
  - name: kafka
    port: 9092
    targetPort: 9092
    nodePort: {{ redpanda_kafka_nodeport }}
  - name: schema-registry
    port: 8081
    targetPort: 8081
    nodePort: {{ redpanda_schema_nodeport }}
---
apiVersion: apps/v1
kind: StatefulSet
metadata:
  name: redpanda
  namespace: {{ redpanda_namespace }}
  labels:
    app: redpanda
spec:
  serviceName: redpanda-headless
  replicas: {{ redpanda_replicas }}
  selector:
    matchLabels:
      app: redpanda
  template:
    metadata:
      labels:
        app: redpanda
    spec:
      initContainers:
      - name: fix-permissions
        image: busybox:latest
        command: ["sh", "-c", "chown -R 101:101 /var/lib/redpanda/data && chmod -R 777 /var/lib/redpanda/data"]
        volumeMounts:
        - name: datadir
          mountPath: /var/lib/redpanda/data
        securityContext:
          runAsUser: 0
      containers:
      - name: redpanda
        image: {{ redpanda_image }}
        imagePullPolicy: IfNotPresent
        env:
        - name: KAFKA_BOOTSTRAP_SERVER
          valueFrom:
            configMapKeyRef:
              name: redpanda-info
              key: KAFKA_BOOTSTRAP_SERVER
        - name: INTERNAL_BOOTSTRAP_SERVER
          valueFrom:
            configMapKeyRef:
              name: redpanda-info
              key: INTERNAL_BOOTSTRAP_SERVER
        command:
        - "rpk"
        - "redpanda"
        - "start"
        - "--mode=dev-container"
        - "--smp=1"
        - "--memory=1G"
        - "--reserve-memory=0M"
        - "--kafka-addr=PLAINTEXT://0.0.0.0:29092,OUTSIDE://0.0.0.0:9092"
        - "--advertise-kafka-addr=PLAINTEXT://$(INTERNAL_BOOTSTRAP_SERVER),OUTSIDE://$(KAFKA_BOOTSTRAP_SERVER)"
        - "--schema-registry-addr=0.0.0.0:8081"
        ports:
        - name: internal
          containerPort: 29092
        - name: external
          containerPort: 9092
        - name: schema
          containerPort: 8081
        - name: admin
          containerPort: 9644
        - name: rpc
          containerPort: 33145
        volumeMounts:
        - name: datadir
          mountPath: /var/lib/redpanda/data
        resources:
          requests:
            cpu: 200m
            memory: 512Mi
          limits:
            cpu: 1500m
            memory: 2Gi
        readinessProbe:
          httpGet:
            path: /v1/status/ready
            port: 9644
          initialDelaySeconds: 5
          periodSeconds: 10
        livenessProbe:
          httpGet:
            path: /v1/status/ready
            port: 9644
          initialDelaySeconds: 15
          periodSeconds: 15
  volumeClaimTemplates:
  - metadata:
      name: datadir
    spec:
      accessModes: [ "ReadWriteOnce" ]
      storageClassName: {{ redpanda_storage_class }}
      resources:
        requests:
          storage: {{ redpanda_pvc_size }}
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: redpanda-console
  namespace: {{ redpanda_namespace }}
  labels:
    app: redpanda-console
spec:
  replicas: 1
  selector:
    matchLabels:
      app: redpanda-console
  template:
    metadata:
      labels:
        app: redpanda-console
    spec:
      containers:
      - name: console
        image: {{ redpanda_console_image }}
        imagePullPolicy: IfNotPresent
        env:
        - name: KAFKA_BROKERS
          valueFrom:
            configMapKeyRef:
              name: redpanda-info
              key: INTERNAL_BOOTSTRAP_SERVER
        - name: KAFKA_SCHEMAREGISTRY_ENABLED
          value: "true"
        - name: KAFKA_SCHEMAREGISTRY_URLS
          valueFrom:
            configMapKeyRef:
              name: redpanda-info
              key: INTERNAL_SCHEMA_REGISTRY
        - name: CONSOLE_TOPICS_DELETE_ENABLED
          value: "true"
        ports:
        - name: http
          containerPort: 8080
        resources:
          requests:
            cpu: 50m
            memory: 64Mi
          limits:
            cpu: 300m
            memory: 256Mi
---
apiVersion: v1
kind: Service
metadata:
  name: redpanda-console-service
  namespace: {{ redpanda_namespace }}
  labels:
    app: redpanda-console
spec:
  type: NodePort
  selector:
    app: redpanda-console
  ports:
  - name: http
    port: 8080
    targetPort: 8080
    nodePort: {{ redpanda_console_nodeport }}
