---
apiVersion: v1
kind: Namespace
metadata:
  name: {{ oracle_namespace }}
  labels:
    app.kubernetes.io/name: oracle
---
apiVersion: v1
kind: Secret
metadata:
  name: oracle-secret
  namespace: {{ oracle_namespace }}
type: Opaque
stringData:
  ORACLE_PASSWORD: "{{ oracle_sys_password }}"
  APP_USER: "{{ oracle_app_user }}"
  APP_USER_PASSWORD: "{{ oracle_app_password }}"
---
apiVersion: v1
kind: ConfigMap
metadata:
  name: oracle-info
  namespace: {{ oracle_namespace }}
  labels:
    app: oracle-db
data:
  HOST: "{{ ansible_host }}"
  PORT: "{{ oracle_nodeport }}"
  SERVICE_NAME: "FREEPDB1"
  SID: "FREE"
  SYS_PASSWORD: "{{ oracle_sys_password }}"
  APP_USER: "{{ oracle_app_user }}"
  APP_PASSWORD: "{{ oracle_app_password }}"
---
apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: oracle-pvc
  namespace: {{ oracle_namespace }}
spec:
  accessModes:
    - ReadWriteOnce
  storageClassName: {{ oracle_storage_class }}
  resources:
    requests:
      storage: {{ oracle_pvc_size }}
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: oracle-db
  namespace: {{ oracle_namespace }}
  labels:
    app: oracle-db
spec:
  replicas: 1
  strategy:
    type: Recreate
  selector:
    matchLabels:
      app: oracle-db
  template:
    metadata:
      labels:
        app: oracle-db
    spec:
      initContainers:
      - name: fix-permissions
        image: busybox:latest
        command: ["sh", "-c", "chown -R 54321:54321 /opt/oracle/oradata && chmod -R 777 /opt/oracle/oradata"]
        volumeMounts:
        - name: oracle-data
          mountPath: /opt/oracle/oradata
        securityContext:
          runAsUser: 0
      containers:
      - name: oracle
        image: {{ oracle_image }}
        imagePullPolicy: IfNotPresent
        ports:
        - name: listener
          containerPort: 1521
        env:
        - name: ORACLE_PASSWORD
          valueFrom:
            configMapKeyRef:
              name: oracle-info
              key: SYS_PASSWORD
        - name: APP_USER
          valueFrom:
            configMapKeyRef:
              name: oracle-info
              key: APP_USER
        - name: APP_USER_PASSWORD
          valueFrom:
            configMapKeyRef:
              name: oracle-info
              key: APP_PASSWORD
        volumeMounts:
        - name: oracle-data
          mountPath: /opt/oracle/oradata
        resources:
          requests:
            cpu: 500m
            memory: 2Gi
          limits:
            cpu: 2000m
            memory: 4Gi
        startupProbe:
          exec:
            command:
            - /bin/bash
            - -c
            - "$ORACLE_HOME/bin/sqlplus -s / as sysdba <<< 'SELECT 1 FROM DUAL;' || exit 1"
          initialDelaySeconds: 30
          periodSeconds: 10
          failureThreshold: 30
        livenessProbe:
          exec:
            command:
            - /bin/bash
            - -c
            - "$ORACLE_HOME/bin/sqlplus -s / as sysdba <<< 'SELECT 1 FROM DUAL;' || exit 1"
          initialDelaySeconds: 10
          periodSeconds: 30
          failureThreshold: 3
      volumes:
      - name: oracle-data
        persistentVolumeClaim:
          claimName: oracle-pvc
---
apiVersion: v1
kind: Service
metadata:
  name: oracle-service
  namespace: {{ oracle_namespace }}
  labels:
    app: oracle-db
spec:
  type: NodePort
  selector:
    app: oracle-db
  ports:
  - name: listener
    port: 1521
    targetPort: 1521
    nodePort: {{ oracle_nodeport }}
