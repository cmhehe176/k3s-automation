# ==============================================================================
# 📋 3. CONSOLE YAML SAMPLES FOR METALLB & INGRESS
# ==============================================================================
apiVersion: console.openshift.io/v1
kind: ConsoleYAMLSample
metadata:
  name: metallb-ipaddresspool-sample
spec:
  targetResource:
    apiVersion: metallb.io/v1beta1
    kind: IPAddressPool
  title: "Default MetalLB IPAddressPool"
  description: "Cấu hình dải IP cấp phát cho LoadBalancer Service"
  yaml: |
    apiVersion: metallb.io/v1beta1
    kind: IPAddressPool
    metadata:
      name: custom-pool
      namespace: metallb-system
    spec:
      addresses:
        - 10.200.10.1-10.200.10.250
---
apiVersion: console.openshift.io/v1
kind: ConsoleYAMLSample
metadata:
  name: metallb-l2advertisement-sample
spec:
  targetResource:
    apiVersion: metallb.io/v1beta1
    kind: L2Advertisement
  title: "Default MetalLB L2Advertisement"
  description: "Quảng bá Layer 2 ARP cho dải IP MetalLB"
  yaml: |
    apiVersion: metallb.io/v1beta1
    kind: L2Advertisement
    metadata:
      name: custom-l2adv
      namespace: metallb-system
    spec:
      ipAddressPools:
        - default-pool
---
apiVersion: console.openshift.io/v1
kind: ConsoleYAMLSample
metadata:
  name: kubernetes-ingress-sample
spec:
  targetResource:
    apiVersion: networking.k8s.io/v1
    kind: Ingress
  title: "Standard Kubernetes Ingress"
  description: "Mẫu cấu hình Kubernetes Ingress điều hướng HTTP/HTTPS"
  yaml: |
    apiVersion: networking.k8s.io/v1
    kind: Ingress
    metadata:
      name: example-ingress
      namespace: default
      annotations:
        kubernetes.io/ingress.class: nginx
    spec:
      rules:
      - host: example.local.pro
        http:
          paths:
          - path: /
            pathType: Prefix
            backend:
              service:
                name: example-service
                port:
                  number: 80
