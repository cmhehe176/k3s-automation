---
apiVersion: v1
kind: ServiceAccount
metadata:
  name: console-sa
  namespace: {{ console_namespace }}
---
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRoleBinding
metadata:
  name: console-admin-binding
subjects:
- kind: ServiceAccount
  name: console-sa
  namespace: {{ console_namespace }}
roleRef:
  kind: ClusterRole
  name: cluster-admin
  apiGroup: rbac.authorization.k8s.io
---
apiVersion: v1
kind: Secret
metadata:
  name: console-cookie-keys
  namespace: {{ console_namespace }}
type: Opaque
stringData:
  cookie-encryption-key: "{{ console_cookie_encryption_key }}"
  cookie-authentication-key: "{{ console_cookie_auth_key }}"
---
