apiVersion: v1
kind: ConfigMap
metadata:
  name: console-config
  namespace: {{ console_namespace }}
  labels:
    app: openshift-console
data:
  BRIDGE_USER_AUTH: "oidc"
  BRIDGE_USER_AUTH_OIDC_ISSUER_URL: "https://{{ ansible_host }}:{{ console_oidc_port }}"
  BRIDGE_USER_AUTH_OIDC_CLIENT_ID: "{{ console_client_id }}"
  BRIDGE_USER_AUTH_OIDC_CA_FILE: "/var/run/secrets/dex-tls/ca.crt"
  BRIDGE_USER_AUTH_OIDC_TOKEN_SCOPES: "email,profile,groups"
  BRIDGE_COOKIE_ENCRYPTION_KEY_FILE: "/var/run/secrets/console-cookie-keys/cookie-encryption-key"
  BRIDGE_COOKIE_AUTHENTICATION_KEY_FILE: "/var/run/secrets/console-cookie-keys/cookie-authentication-key"
  BRIDGE_USER_SETTINGS_LOCATION: "localstorage"
  BRIDGE_CUSTOM_PRODUCT_NAME: "Red Hat OpenShift Container Platform"
  BRIDGE_CUSTOM_LOGO_FILES: "Dark=/var/run/secrets/console-logos/openshift-logo-dark.svg,Light=/var/run/secrets/console-logos/openshift-logo-light.svg"
  BRIDGE_CUSTOM_FAVICON_FILES: "Dark=/opt/bridge/static/imgs/openshift-favicon.png,Light=/opt/bridge/static/imgs/openshift-favicon.png"
  BRIDGE_BASE_ADDRESS: "http://{{ ansible_host }}:{{ console_nodeport }}"
  BRIDGE_K8S_MODE: "in-cluster"
  BRIDGE_LISTEN: "http://0.0.0.0:9000"
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: openshift-console
  namespace: {{ console_namespace }}
  labels:
    app: openshift-console
spec:
  replicas: 1
  selector:
    matchLabels:
      app: openshift-console
  template:
    metadata:
      labels:
        app: openshift-console
    spec:
      serviceAccountName: console-sa
{% if ansible_host != node_ip %}
      hostAliases:
      - ip: "{{ node_ip }}"
        hostnames:
        - "{{ ansible_host }}"
{% endif %}
      containers:
      - name: console
        image: {{ console_image }}
        ports:
        - name: http
          containerPort: 9000
        envFrom:
        - configMapRef:
            name: console-config
        env:
        - name: BRIDGE_USER_AUTH_OIDC_CLIENT_SECRET
          value: "{{ console_client_secret }}"
        volumeMounts:
        - name: cookie-keys
          mountPath: /var/run/secrets/console-cookie-keys
          readOnly: true
        - name: dex-tls
          mountPath: /var/run/secrets/dex-tls
          readOnly: true
        - name: custom-logos
          mountPath: /var/run/secrets/console-logos
          readOnly: true
        resources:
          requests:
            cpu: 100m
            memory: 128Mi
          limits:
            cpu: 500m
            memory: 512Mi
      volumes:
      - name: cookie-keys
        secret:
          secretName: console-cookie-keys
      - name: dex-tls
        secret:
          secretName: dex-tls
      - name: custom-logos
        configMap:
          name: console-custom-logos
---
apiVersion: v1
kind: Service
metadata:
  name: openshift-console
  namespace: {{ console_namespace }}
  labels:
    app: openshift-console
spec:
  type: {{ console_service_type }}
  selector:
    app: openshift-console
  ports:
  - name: http
    port: 9000
    targetPort: 9000
{% if console_service_type == 'NodePort' %}
    nodePort: {{ console_nodeport }}
{% endif %}
