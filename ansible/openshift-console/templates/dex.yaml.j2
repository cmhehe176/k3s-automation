  styles.css: |
    .theme-body {
      background-color: #f0f2f5;
      color: #151515;
      font-family: 'Red Hat Text', 'Red Hat Display', 'Overpass', sans-serif;
    }
    .theme-navbar {
      background-color: #151515;
      color: #fff;
      height: 54px;
      padding: 0 20px;
      border-bottom: 3px solid #ee0000;
      box-shadow: 0 2px 8px rgba(0,0,0,0.3);
    }
    .theme-navbar__logo-wrap {
      display: flex;
      align-items: center;
      height: 100%;
      padding: 0;
    }
    .theme-navbar__logo {
      height: 32px;
      max-height: 32px;
    }
    .theme-panel {
      background-color: #ffffff;
      border-radius: 8px;
      box-shadow: 0 12px 32px rgba(0, 0, 0, 0.15);
      border-top: 4px solid #ee0000;
      padding: 40px 36px;
      margin-top: 50px;
    }
    .theme-heading {
      font-size: 22px;
      font-weight: 700;
      color: #151515;
      margin-bottom: 24px;
      text-align: center;
    }
    .theme-btn--primary {
      background-color: #ee0000;
      border-radius: 4px;
      font-weight: 700;
      font-size: 15px;
      height: 42px;
      border: none;
      width: 100%;
      cursor: pointer;
      transition: background-color 0.2s ease;
    }
    .theme-btn--primary:hover {
      background-color: #be0000;
    }
    .theme-form-input {
      border-radius: 4px;
      border: 1px solid #d2d2d2;
      height: 42px;
      width: 100%;
      padding: 8px 12px;
      font-size: 14px;
    }
    .theme-form-input:focus {
      border-color: #06c;
      box-shadow: 0 0 0 2px rgba(0, 102, 204, 0.25);
      outline: none;
    }
    .theme-form-label {
      font-size: 14px;
      font-weight: 600;
      color: #333;
      margin-bottom: 6px;
      width: 100%;
    }
---
apiVersion: v1
kind: ConfigMap
metadata:
  name: dex-config
  namespace: {{ console_namespace }}
data:
  config.yaml: |
    issuer: https://{{ ansible_host }}:{{ console_oidc_port }}
    storage:
      type: sqlite3
      config:
        file: /var/dex/dex.db
    web:
      https: 0.0.0.0:5556
      tlsCert: /etc/dex/tls/tls.crt
      tlsKey: /etc/dex/tls/tls.key
    telemetry:
      http: 0.0.0.0:5558
    oauth2:
      skipApprovalScreen: true
    frontend:
      issuer: "Red Hat OpenShift"
    staticClients:
      - id: {{ console_client_id }}
        redirectURIs:
          - 'http://{{ ansible_host }}:{{ console_nodeport }}/auth/callback'
        name: 'OpenShift Web Console'
        secret: {{ console_client_secret }}
    enablePasswordDB: true
    staticPasswords:
{% for u in users_with_hashes %}
      - email: "{{ u.email }}"
        hash: "{{ u.hash }}"
        username: "{{ u.username }}"
        userID: "{{ u.userID }}"
{% endfor %}
---
apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: dex-data
  namespace: {{ console_namespace }}
  labels:
    app: dex
spec:
  accessModes:
    - ReadWriteOnce
{% if dex_storage_class is defined and dex_storage_class != "" %}
  storageClassName: {{ dex_storage_class }}
{% endif %}
  resources:
    requests:
      storage: {{ dex_storage_size | default('1Gi') }}
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: dex
  namespace: {{ console_namespace }}
  labels:
    app: dex
spec:
  replicas: 1
  selector:
    matchLabels:
      app: dex
  template:
    metadata:
      labels:
        app: dex
    spec:
      serviceAccountName: dex
      securityContext:
        fsGroup: 1001
      containers:
      - name: dex
        image: ghcr.io/dexidp/dex:v2.41.1
        command:
        - "/usr/local/bin/dex"
        - "serve"
        - "/etc/dex/cfg/config.yaml"
        ports:
        - name: https
          containerPort: 5556
        - name: telemetry
          containerPort: 5558
        volumeMounts:
        - name: dex-data
          mountPath: /var/dex
        - name: config
          mountPath: /etc/dex/cfg
        - name: tls
          mountPath: /etc/dex/tls
          readOnly: true
        - name: logo
          mountPath: /srv/dex/web/themes/light/logo.png
          subPath: logo.png
        - name: logo
          mountPath: /srv/dex/web/themes/dark/logo.png
          subPath: logo.png
        - name: logo
          mountPath: /srv/dex/web/themes/light/styles.css
          subPath: styles.css
        - name: logo
          mountPath: /srv/dex/web/themes/dark/styles.css
          subPath: styles.css
        resources:
          requests:
            cpu: 50m
            memory: 64Mi
          limits:
            cpu: 200m
            memory: 256Mi
      volumes:
      - name: dex-data
        persistentVolumeClaim:
          claimName: dex-data
      - name: config
        configMap:
          name: dex-config
      - name: tls
        secret:
          secretName: dex-tls
      - name: logo
        configMap:
          name: dex-custom-logo
---
apiVersion: v1
kind: Service
metadata:
  name: dex
  namespace: {{ console_namespace }}
  labels:
    app: dex
spec:
  type: LoadBalancer
  selector:
    app: dex
  ports:
  - name: https
    port: 5556
    targetPort: 5556
    nodePort: {{ console_oidc_port }}
