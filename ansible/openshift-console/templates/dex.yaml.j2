---
apiVersion: v1
kind: Namespace
metadata:
  name: {{ console_namespace }}
  labels:
    app.kubernetes.io/name: openshift-console
---
apiVersion: v1
kind: ServiceAccount
metadata:
  name: dex
  namespace: {{ console_namespace }}
---
apiVersion: v1
kind: Secret
metadata:
  name: dex-tls
  namespace: {{ console_namespace }}
type: Opaque
data:
  tls.crt: "{{ dex_tls_crt_b64 }}"
  tls.key: "{{ dex_tls_key_b64 }}"
  ca.crt: "{{ dex_ca_crt_b64 }}"
---
