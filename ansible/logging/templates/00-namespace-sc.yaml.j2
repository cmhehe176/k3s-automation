apiVersion: v1
kind: Namespace
metadata:
  name: {{ logging_namespace }}
---
# Longhorn mac dinh numberOfReplicas=3 nhung cum chi co 2 node
# => volume se ket o trang thai Degraded vinh vien. Dung SC rieng r=2.
apiVersion: storage.k8s.io/v1
kind: StorageClass
metadata:
  name: {{ elasticsearch_storage_class }}
provisioner: driver.longhorn.io
allowVolumeExpansion: true
reclaimPolicy: Retain
volumeBindingMode: Immediate
parameters:
  numberOfReplicas: "{{ elasticsearch_storage_replicas }}"
  staleReplicaTimeout: "30"
  fsType: ext4
